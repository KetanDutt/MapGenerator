# Dependencies
# (the project itself has none — this only matters if you install tooling)
node_modules/

# Build output — nothing here is generated by the project, but editors and
# ad-hoc exports sometimes drop things in these folders.
dist/
build/
out/

# Local exports from the editor (JSON/PNG levels you are trying out)
parking-level-*.json
parking-level-*.png

# Logs
*.log
npm-debug.log*

# Editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# Test artifacts
coverage/
.nyc_output/
